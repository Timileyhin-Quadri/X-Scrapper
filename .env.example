# CSV Storage (Default - Zero setup required)
CSV_OUTPUT_PATH=data/tweets.csv

# PostgreSQL Configuration (Optional - only required when using --use-db flag)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=x_research
DB_USER=postgres
DB_PASSWORD=

# Collection Defaults
DEFAULT_QUERY=#PutSouthAfricaFirst -is:retweet
COLLECTION_INTERVAL_SECONDS=300

# Playwright / Google Chromium CDP Debugging Port
CDP_PORT=922
CHROME_PATH=
SESSION_PATH=session.json
